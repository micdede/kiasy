# kiasy v2 — Environment-Vorlage
#
# Kopieren: cp .env.example .env
# Werte aus altem System: /home/mcde/whatsapp-claude/.env (manuell übertragen)

# ─── Allgemein ─────────────────────────────────────────────
TZ=Europe/Berlin
NODE_ENV=production

# ─── Monitor-Auth ──────────────────────────────────────────
MONITOR_USER=admin
MONITOR_PASS=changeme

# ─── LLM ───────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | anthropic | openai
OLLAMA_MODEL=minimax-m2.7:cloud
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=              # für Bildgenerierung

# ─── STT (Whisper) ─────────────────────────────────────────
WHISPER_MODEL=medium         # tiny | base | small | medium | large-v3
WHISPER_URL_OVERRIDE=        # optional: extern statt lokal

# ─── TTS (Piper) ───────────────────────────────────────────
PIPER_VOICE=de_DE-thorsten-medium
PIPER_URL_OVERRIDE=          # optional: extern statt lokal

# ─── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_USERS=      # comma-separated chat-IDs

# ─── Mail (Kerio) ──────────────────────────────────────────
KERIO_HOST=wrsk-mail.de
KERIO_USER=jarvis
KERIO_PASS=
KERIO_FROM=jarvis@wrsk-mail.de

# ─── Calendar (CalDAV) ─────────────────────────────────────
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# ─── Home Assistant ────────────────────────────────────────
HOMEASSISTANT_URL=http://192.168.178.8:8123
HOMEASSISTANT_TOKEN=

# ─── News-APIs (optional) ──────────────────────────────────
NEWS_API_KEY=
NEWSDATA_API_KEY=

# ─── Embedding-Modell für Qdrant ───────────────────────────
EMBED_MODEL=bge-m3:latest
EMBED_DIM=1024

# ─── Backup ────────────────────────────────────────────────
BACKUP_REMOTE=               # optional: user@host:/pfad/ für scp-Sync
BACKUP_KEEP=14               # lokale Backups behalten

# ─── Notes / Wissensbasis Git-Sync ─────────────────────────
GITHUB_NOTES_REPO=           # ssh-URL, optional (für git-sync)
